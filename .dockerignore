# Keep the build context lean — frontend/ is COPY'd whole, so exclude
# things that don't belong in a production image.
**/node_modules
**/.git
**/dist-test
**/*.tsbuildinfo

# We bundle backend/dist explicitly; ignore the rest of backend/
backend/src
backend/test
backend/tsconfig*.json

# Frontend is served pre-built (dist + assets); its sources/build config
# aren't needed in the runtime image (package.json is kept for the
# workspace definition).
frontend/src
frontend/test
frontend/gulpfile.js
frontend/webpack.config.js
frontend/tsconfig.json
frontend/vitest.config.ts

# Repo housekeeping
.git
.idea
.vscode
.cache
data
imports
old-backend
mwpa_*.tar
*.log
# schemas/src and tsbuildinfo aren't needed at runtime (dist is enough)
# but the folder itself is copied for the workspace install.